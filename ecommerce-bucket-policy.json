{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEcommerceAccessFromSpecificIP",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ecommerce-payment-data",
        "arn:aws:s3:::ecommerce-payment-data/*"
      ],
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "your_ip_address/24"
        }
      }
    },
    {
      "Sid": "RestrictEcommerceAccessToFinanceTeam",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ecommerce-payment-data",
        "arn:aws:s3:::ecommerce-payment-data/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/Role": "analyst_team"
        }
      }
    }
  ]
}
